# strike-watch: the storyteller.
#
# Watches etcd and the /health endpoints and tells what happens: who is
# elected, who burns out, who recovers. One thing: narrate.
#
#     ./strike-watch -d 60
#     ./strike-watch           # forever, Ctrl-C to stop

import argparse
import http.client
import sys
import time

import strikeapi


def classify(status, text):
    """ The state a /health answer describes. """

    if text.startswith('on strike'):
        return 'on strike'
    if status == 418:
        return 'burned out'
    if text.startswith('leading'):
        return 'leading'
    return 'healthy'


def main():
    parser = argparse.ArgumentParser(
        prog='strike-watch',
        description="Narrate what happens in the calculators' workforce.")
    parser.add_argument('-d', '--duration', type=float, default=0.0,
                        help="seconds of narration, 0 for until Ctrl-C "
                             "(default: 0)")
    parser.add_argument('-i', '--interval', type=float, default=0.5,
                        help="seconds between polls (default: 0.5)")
    parser.add_argument('--nodes', type=int, default=5,
                        help="number of nodes in the workforce (default: 5)")
    parser.add_argument('--port-base', type=int, default=12345,
                        help="host port of node1, following nodes +1 "
                             "(default: 12345)")
    parser.add_argument('--etcd', default='127.0.0.1:2379',
                        help="etcd address as seen from here "
                             "(default: 127.0.0.1:2379)")
    args = parser.parse_args()

    node_map = strikeapi.nodes(args.nodes, args.port_base)
    deadline = time.monotonic() + args.duration if args.duration > 0 else None

    # The leader at start-up is old news (strike-up already told about
    # it): the watcher announces the changes.
    try:
        leader = strikeapi.leader_name(args.etcd)
    except OSError:
        leader = None
    states = {}

    try:
        while deadline is None or time.monotonic() < deadline:
            time.sleep(args.interval)

            try:
                current = strikeapi.leader_name(args.etcd)
            except OSError:
                continue
            if current != leader:
                if current is None:
                    strikeapi.stamp(f"the leader ({leader}) is gone, "
                                    f"electing a new one...")
                else:
                    strikeapi.stamp(f"we see {current} is elected leader")
                leader = current

            for name, port in node_map.items():
                try:
                    status, _, body = strikeapi.req(port, 'GET', '/health',
                                                    timeout=2.0)
                    state = classify(status,
                                     body.decode('utf-8', errors='replace'))
                    text = body.decode('utf-8', errors='replace')
                except (OSError, http.client.HTTPException):
                    state, text = 'down', ''

                old = states.get(name)
                states[name] = state

                # The chaos monkey tells about the strikes and etcd
                # about the elections, tell the rest.
                if (state != old and old is not None
                        and state not in ('on strike', 'leading')):
                    strikeapi.stamp(f"{name}: {state}"
                                    + (f" ({text})" if text else ""))
    except KeyboardInterrupt:
        pass

    strikeapi.stamp("the storyteller goes home")


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
