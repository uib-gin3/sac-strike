#!/bin/sh

# strike-up: bring the workforce up. One thing: bring it up.
#
# No waiting here: the readiness is strike-ready's business, and
# strike-demo composes both. The metrics start fresh, even over a
# leftover redis.
#
#     ./strike-up

cd "$(dirname "$0")" || exit 1

echo "starting the workforce: etcd + redis + 5 calculators (docker compose up -d --build)"
docker compose up -d --build \
    || { echo "docker compose failed, is docker up?" >&2; exit 1; }

# A run starts with clean metrics, even over a leftover redis. Right
# after compose up redis may still be waking up, so the attempt pings
# it first (the wipe's own pipeline would hide that failure) and the
# loop retries briefly instead of failing over that.
n=0
until docker compose exec -T redis sh -c \
      'redis-cli ping > /dev/null 2>&1 || exit 1
       redis-cli --scan --pattern "strike:*" | xargs -r redis-cli del' \
      > /dev/null; do
    n=$((n + 1))
    if [ "$n" -ge 5 ]; then
        echo "redis is not answering (docker compose exec redis ...)" >&2
        exit 1
    fi
    sleep 0.5
done
