# strike-leader: where to send the requests.
#
# Reads the leadership from etcd (strike/leader holds the endpoint of
# the leader) and answers with a base URL for the host, or with the raw
# endpoint when --endpoint is given. It retries for a couple of seconds
# so the sub-second leaderless gaps do not matter. One thing: answer
# the question.
#
#     ./strike-leader            # http://localhost:12346
#     ./strike-leader --endpoint # http://node2:12345
#
# So the requests can inline the discovery, and each one finds whoever
# leads at that moment:
#
#     curl -s -X POST $(./strike-leader)/calc --data-binary 3,4,5,6

import argparse
import sys

import strikeapi


def main():
    parser = argparse.ArgumentParser(
        prog='strike-leader',
        description="Answer with the base URL of the current leader.")
    parser.add_argument('--nodes', type=int, default=5,
                        help="number of nodes in the workforce (default: 5)")
    parser.add_argument('--port-base', type=int, default=12345,
                        help="host port of node1, following nodes +1 "
                             "(default: 12345)")
    parser.add_argument('--etcd', default='127.0.0.1:2379',
                        help="etcd address as seen from here "
                             "(default: 127.0.0.1:2379)")
    parser.add_argument('--endpoint', action='store_true',
                        help="print the raw endpoint etcd holds "
                             "(http://nodeN:12345) instead of the base URL")
    args = parser.parse_args()

    if args.endpoint:
        endpoint = strikeapi.leader_endpoint(args.etcd)
        if endpoint is None:
            print("no leader in etcd (is the workforce running?)",
                  file=sys.stderr)
            return 1
        print(endpoint)
        return 0

    port = strikeapi.leader_port(args.etcd, args.nodes, args.port_base)
    if port is None:
        print("no leader in etcd (is the workforce running?)", file=sys.stderr)
        return 1

    print(f"http://localhost:{port}")
    return 0


if __name__ == '__main__':
    sys.exit(main())
