# strike-chaos: the agitator.
#
# Puts random nodes on strike every few seconds. One thing: cause chaos.
#
#     ./strike-chaos -d 60
#     ./strike-chaos           # forever, Ctrl-C to stop

import argparse
import http.client
import random
import sys
import time

import strikeapi


def main():
    parser = argparse.ArgumentParser(
        prog='strike-chaos',
        description="Put random nodes of the workforce on strike.")
    parser.add_argument('-d', '--duration', type=float, default=0.0,
                        help="seconds of chaos, 0 for until Ctrl-C "
                             "(default: 0)")
    parser.add_argument('--gap-min', type=float, default=4.0,
                        help="minimum seconds between strikes (default: 4)")
    parser.add_argument('--gap-max', type=float, default=9.0,
                        help="maximum seconds between strikes (default: 9)")
    parser.add_argument('--nodes', type=int, default=5,
                        help="number of nodes in the workforce (default: 5)")
    parser.add_argument('--port-base', type=int, default=12345,
                        help="host port of node1, following nodes +1 "
                             "(default: 12345)")
    args = parser.parse_args()

    node_map = strikeapi.nodes(args.nodes, args.port_base)
    deadline = time.monotonic() + args.duration if args.duration > 0 else None

    strikeapi.stamp(f"the chaos monkey is loose: a strike every "
                    f"{args.gap_min:.0f}-{args.gap_max:.0f}s")

    strikes = 0
    try:
        while deadline is None or time.monotonic() < deadline:
            delay = random.uniform(args.gap_min, args.gap_max)
            if deadline is not None:
                delay = min(delay, max(0.0, deadline - time.monotonic()))
            time.sleep(delay)
            if deadline is not None and time.monotonic() >= deadline:
                break
            name, port = random.choice(list(node_map.items()))
            try:
                _, _, body = strikeapi.req(port, 'POST', '/strike')
            except (OSError, http.client.HTTPException):
                continue
            strikes += 1
            text = body.decode('utf-8', errors='replace').strip()
            strikeapi.stamp(f"the chaos monkey sends {name} on strike ({text})")
    except KeyboardInterrupt:
        pass

    strikeapi.stamp(f"the chaos monkey is done: {strikes} strikes")


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
