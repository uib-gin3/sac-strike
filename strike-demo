#!/bin/sh

# strike-demo: the whole show, composed out of the single-purpose
# commands. Every tool does one thing (unix philosophy); this script
# just runs them in the right order. About a minute of tests.
#
#     ./strike-demo                     # 5 clients x 3 ops/s, 60s
#     ./strike-demo -c 3 -r 2 -d 30
#     ./strike-demo -d 60 --keep
#
# Everything after -c/-r/-d/--keep goes to the tools (--nodes,
# --port-base, --etcd, ...).

set -u

CLIENTS=5
RATE=3.0
DURATION=60
KEEP=0

while [ $# -gt 0 ]; do
    case "$1" in
        -c) CLIENTS=$2; shift 2 ;;
        -r) RATE=$2; shift 2 ;;
        -d) DURATION=$2; shift 2 ;;
        --keep) KEEP=1; shift ;;
        *) break ;;
    esac
done

# One shared clock: every tool narrates on the same timeline.
STRIKE_T0=$(python3 -c 'import time; print(f"{time.time():.3f}")')
export STRIKE_T0

echo "=== The calculators' strike ==="

./strike-up "$@" || exit 1
./strike-ready "$@" || exit 1

./strike-chaos -d "$DURATION" "$@" &
CHAOS=$!
./strike-watch -d "$DURATION" "$@" &
WATCH=$!
trap 'kill $CHAOS $WATCH 2>/dev/null' INT TERM

./strike-load -c "$CLIENTS" -r "$RATE" -d "$DURATION" "$@"
wait "$CHAOS" 2>/dev/null || true
wait "$WATCH" 2>/dev/null || true

./strike-summary -d "$DURATION" "$@"

if [ "$KEEP" = "0" ]; then
    docker compose down
else
    echo "[strike-demo] leaving the workforce running (--keep)"
fi
