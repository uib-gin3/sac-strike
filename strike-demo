#!/usr/bin/env python3

# This file has been implemented with GLM-5.3-Flash on OpenCode

# strike-demo: "The calculators' strike", the whole show in about a minute.
#
# It starts the fleet with docker compose (5 calculator nodes + etcd +
# redis), sends a steady workload to whoever etcd says is the leader, lets
# a chaos monkey put random nodes on strike and narrates everything that
# happens. When the run is over it reads the metrics the leader stored in
# Redis and prints a summary.
#
# Standard library only: the tiny RESP client below is all it takes to
# read Redis from the host.

import argparse
import base64
import http.client
import json
import random
import socket
import subprocess
import sys
import threading
import time
import urllib.request
from pathlib import Path

HOME = Path(__file__).resolve().parent
LEADER_KEY = 'strike/leader'

OPS = ('add', 'sub', 'div', 'mult', 'sqrt', 'mean', 'std')


######################### Tiny clients ########################################

class Resp:
    """ A minimal Redis (RESP) client, just enough to read the summary. """

    def __init__(self, host, port, timeout=3.0):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.rfile = self.sock.makefile('rb')

    def command(self, *args):
        """ Send a command and read its single reply. """

        payload = f"*{len(args)}\r\n".encode()
        for arg in args:
            arg = str(arg).encode()
            payload += f"${len(arg)}\r\n".encode() + arg + b"\r\n"

        self.sock.sendall(payload)
        return self._reply()

    def _reply(self):
        line = self.rfile.readline()
        if not line:
            raise OSError("connection closed by redis")
        kind, rest = line[:1], line[1:-2]
        if kind == b'+':
            return rest.decode()
        if kind == b'-':
            raise RuntimeError(rest.decode())
        if kind == b':':
            return int(rest)
        if kind == b'$':
            length = int(rest)
            if length == -1:
                return None
            return self.rfile.read(length + 2)[:-2].decode('utf-8',
                                                           errors='replace')
        if kind == b'*':
            return [self._reply() for _ in range(int(rest))]
        raise OSError(f"bad RESP line: {line!r}")

    def close(self):
        self.sock.close()


def etcd_get(etcd, key):
    """ Read a key from etcd through the v3 JSON gateway. """

    payload = json.dumps({'key': base64.b64encode(key.encode()).decode()})
    http_request = urllib.request.Request(
        f"http://{etcd}/v3/kv/range", data=payload.encode(),
        headers={'Content-Type': 'application/json'})

    with urllib.request.urlopen(http_request, timeout=2.0) as reply:
        answer = json.loads(reply.read())

    kvs = answer.get('kvs') or []
    return base64.b64decode(kvs[0]['value']).decode() if kvs else None


def req(port, method, path, body=None, timeout=5.0):
    """ One plain HTTP request to localhost:port, returns (status, headers,
    " body). Headers come lowercased in a dict.
    """

    conn = http.client.HTTPConnection('127.0.0.1', port, timeout=timeout)
    try:
        conn.request(method, path, body=body,
                     headers={'Content-Type': 'text/plain; charset=utf-8'}
                     if body else {})
        raw = conn.getresponse()
        return raw.status, {k.lower(): v for k, v in raw.getheaders()}, raw.read()
    finally:
        conn.close()


######################### The workload ########################################

class Striker(threading.Thread):
    """ One simulated user.

    " Keeps asking the current leader (as etcd says) for operations: create
    " a calculus, apply an operation, forget it. Failures make it look for
    " a new leader right away.
    """

    def __init__(self, nodes, etcd, args, deadline, stop):
        super().__init__(daemon=True)
        self.nodes = nodes
        self.etcd = etcd
        self.args = args
        self.deadline = deadline
        self.stop = stop
        self.served = 0
        self.requests = 0
        self.teapots = 0
        self.errors_4xx = 0
        self.errors_5xx = 0
        self.conn_errors = 0
        self.latencies = []
        self.served_by = {}
        self._leader = None
        self._leader_when = 0.0

    def leader_port(self):
        """ The port of the leader, remembered for half a second. """

        now = time.monotonic()
        if now - self._leader_when > 0.5:
            self._leader_when = now
            try:
                name = etcd_get(self.etcd, LEADER_KEY)
            except OSError:
                name = self._leader
            if name in self.nodes:
                self._leader = name

        name = self._leader or random.choice(list(self.nodes))
        return self.nodes[name]

    def invalidate(self):
        self._leader_when = 0.0

    def do(self, method, path, body=None):
        started = time.monotonic()
        try:
            status, headers, data = req(self.leader_port(), method, path, body)
        except (OSError, http.client.HTTPException):
            self.requests += 1
            self.conn_errors += 1
            self.invalidate()
            return None

        self.requests += 1
        self.latencies.append(time.monotonic() - started)

        if status == 418:
            self.teapots += 1
            self.invalidate()
        elif status >= 500:
            self.errors_5xx += 1
            self.invalidate()
        elif status >= 400:
            self.errors_4xx += 1
            self.invalidate()

        return status, headers, data

    def payload(self):
        """ The operation and the operands of the next request. """

        op = random.choice(OPS)
        count = 1 if op == 'sqrt' else random.randint(20, 50)
        return op, [random.randint(1, 100) for _ in range(count)]

    def operation(self):
        """ Create the calculus, apply the operation, forget it. """

        op, numbers = self.payload()
        body = ','.join(str(number) for number in numbers).encode()

        first = self.do('POST', '/calc', body)
        if first is None or first[0] != 201:
            return
        calc_id = first[2].decode().strip()

        try:
            second = self.do('GET', f'/calc/{calc_id}/{op}')
            if second is None or second[0] != 200:
                return
            who = second[1].get('x-served-by')
            if who:
                self.served_by[who] = self.served_by.get(who, 0) + 1
            self.served += 1
        finally:
            self.do('DELETE', f'/calc/{calc_id}')

    def run(self):
        rng = random.Random()
        try:
            while not self.stop.is_set() and time.monotonic() < self.deadline:
                if self.args.rate > 0:
                    remaining = self.deadline - time.monotonic()
                    if remaining <= 0:
                        break
                    delay = min(rng.expovariate(self.args.rate), remaining)
                    if self.stop.wait(delay):
                        break
                self.operation()
        except KeyboardInterrupt:
            pass


######################### The chaos monkey ####################################

class ChaosMonkey(threading.Thread):
    """ Puts random nodes on strike. The strike needs agitators. """

    def __init__(self, nodes, stop, t0, gap_min, gap_max):
        super().__init__(daemon=True)
        self.nodes = nodes
        self.stop = stop
        self.t0 = t0
        self.gap_min = gap_min
        self.gap_max = gap_max
        self.strikes = 0

    def run(self):
        while not self.stop.wait(random.uniform(self.gap_min, self.gap_max)):
            name, port = random.choice(list(self.nodes.items()))
            try:
                status, _, body = req(port, 'POST', '/strike')
            except (OSError, http.client.HTTPException):
                continue
            self.strikes += 1
            text = body.decode('utf-8', errors='replace').strip()
            print(f"[{time.monotonic() - self.t0:6.1f}s] the chaos monkey sends "
                  f"{name} on strike ({text})", flush=True)


######################### The narrator ########################################

class Narrator(threading.Thread):
    """ Watches etcd and the /health endpoints and tells the story. """

    def __init__(self, nodes, etcd, stop, t0, leader=None):
        super().__init__(daemon=True)
        self.nodes = nodes
        self.etcd = etcd
        self.stop = stop
        self.t0 = t0
        self.leader = leader
        self.states = {}

    def say(self, text):
        print(f"[{time.monotonic() - self.t0:6.1f}s] {text}", flush=True)

    def run(self):
        while not self.stop.wait(0.5):
            try:
                leader = etcd_get(self.etcd, LEADER_KEY)
            except OSError:
                continue
            if leader != self.leader:
                if leader is None:
                    self.say(f"the leader ({self.leader}) is gone, "
                             f"electing a new one...")
                else:
                    self.say(f"we see {leader} is elected leader")
                self.leader = leader

            for name, port in self.nodes.items():
                try:
                    status, _, body = req(port, 'GET', '/health', timeout=2.0)
                    text = body.decode('utf-8', errors='replace')
                    state = ('on strike' if text.startswith('on strike')
                             else 'burned out' if status == 418
                             else 'leading' if text.startswith('leading')
                             else 'healthy')
                except (OSError, http.client.HTTPException):
                    state, text = 'down', ''

                old = self.states.get(name)
                self.states[name] = state

                # The chaos monkey already tells about the strikes and
                # etcd about the elections, tell the rest.
                worth = (state != old and old is not None
                         and state not in ('on strike', 'leading'))
                if worth:
                    self.say(f"{name}: {state}" + (f" ({text})" if text else ""))


######################### The summary #########################################

def percentile(sorted_samples, p):
    if not sorted_samples:
        return 0.0
    k = (len(sorted_samples) - 1) * p / 100
    lo = int(k)
    hi = min(lo + 1, len(sorted_samples) - 1)
    return sorted_samples[lo] + (sorted_samples[hi] - sorted_samples[lo]) * (k - lo)


def read_metrics(redis_addr, nodes, elapsed, wall_t0):
    """ The metrics the leader stored in Redis while serving. """

    resp = Resp(*redis_addr)
    try:
        keys = [k for k in (resp.command('KEYS', 'strike:*') or [])
                if not k.startswith('strike:events')]

        values = resp.command('MGET', *keys) if keys else []
        counters = dict(zip(keys, values))

        raw_events = resp.command('LRANGE', 'strike:events', 0, -1) or []
    finally:
        resp.close()

    events = []
    for raw in raw_events:
        try:
            events.append(json.loads(raw))
        except ValueError:
            pass
    events.sort(key=lambda event: event.get('t', 0))

    def number(key):
        value = counters.get(key)
        return float(value) if value else 0.0

    per_node = {}
    for node in sorted(set(list(nodes) +
                           [k.split(':', 2)[2] for k in counters
                            if k.startswith('strike:ok:')])):
        ok = int(number(f"strike:ok:{node}"))
        fail = int(number(f"strike:fail:{node}"))
        total = number(f"strike:time:{node}")
        per_node[node] = {
            'served': ok,
            'failed': fail,
            'avg_ms': total / ok * 1000 if ok else 0.0,
            'strikes': 0,
            'burnouts': 0,
            'tenures': 0,
            'leading': 0.0,
        }

    for event in events:
        node = per_node.setdefault(event['node'], {
            'served': 0, 'failed': 0, 'avg_ms': 0.0, 'strikes': 0,
            'burnouts': 0, 'tenures': 0, 'leading': 0.0})
        if event['kind'] == 'on_strike':
            node['strikes'] += 1
        elif event['kind'] == 'burned_out':
            node['burnouts'] += 1

    # The leadership tenures, rebuilt from the event log: an 'elected'
    # opens one, a step down or a burnout closes it, the next election
    # also closes whatever was left open.
    current = None
    timeline = []
    for event in events:
        kind, node, when = event['kind'], event['node'], event.get('t', 0)
        if kind == 'elected':
            if current:
                timeline.append((current[0], current[1], when))
            current = (node, when)
        elif kind in ('stepped_down', 'burned_out') and current \
                and current[0] == node:
            timeline.append((current[0], current[1], when))
            current = None
    if current:
        timeline.append((current[0], current[1], wall_t0 + elapsed))

    for node, start, end in timeline:
        if node in per_node:
            per_node[node]['tenures'] += 1
            per_node[node]['leading'] += max(0.0, end - start)

    return {
        'events': events,
        'per_node': per_node,
        'self_served': int(number('strike:self')),
        'delegated': int(number('strike:delegated')),
        'orphans': sum(1 for event in events if event['kind'] == 'orphans'),
        'timeline': timeline,
    }


def print_summary(args, nodes, strikers, chaos, metrics, elapsed, wall_t0):
    offered = args.clients * args.rate * elapsed
    served = sum(striker.served for striker in strikers)
    requests = sum(striker.requests for striker in strikers)
    teapots = sum(striker.teapots for striker in strikers)
    errors_4xx = sum(striker.errors_4xx for striker in strikers)
    errors_5xx = sum(striker.errors_5xx for striker in strikers)
    conn_errors = sum(striker.conn_errors for striker in strikers)
    latencies = sorted(sample for striker in strikers
                       for sample in striker.latencies)

    print()
    print("=== summary ===")
    print(f"duration        : {elapsed:.1f}s")
    print(f"offered (approx): {offered:.0f} ops "
          f"({args.clients} clients x {args.rate} ops/s)")
    print(f"served          : {served} ops / {requests} reqs")
    print(f"teapots (418)   : {teapots}")
    print(f"errors          : {errors_4xx + errors_5xx + conn_errors} "
          f"(4xx: {errors_4xx}, 5xx: {errors_5xx}, conn: {conn_errors})")
    if latencies:
        print(f"latency         : avg={sum(latencies) / len(latencies) * 1000:.1f}ms "
              f"p50={percentile(latencies, 50) * 1000:.1f}ms "
              f"p95={percentile(latencies, 95) * 1000:.1f}ms "
              f"p99={percentile(latencies, 99) * 1000:.1f}ms "
              f"max={latencies[-1] * 1000:.1f}ms")
    handled = metrics['self_served'] + metrics['delegated']
    if handled:
        print(f"leader handled  : {handled} reqs (self: {metrics['self_served']} "
              f"= {metrics['self_served'] / handled * 100:.1f}%, "
              f"delegated: {metrics['delegated']} "
              f"= {metrics['delegated'] / handled * 100:.1f}%)")
    print(f"orphans (503)   : {metrics['orphans']}")
    print(f"chaos strikes   : {chaos.strikes}")

    print()
    print("per node (every request as the leader recorded it):")
    print(f"{'node':<8}{'ok':>7}{'fail':>7}{'avg_ms':>8}"
          f"{'strikes':>9}{'burnouts':>10}{'leading':>9}{'leader%':>9}")
    for node, stats in metrics['per_node'].items():
        share = stats['leading'] / elapsed * 100 if elapsed else 0.0
        print(f"{node:<8}{stats['served']:>7}{stats['failed']:>7}"
              f"{stats['avg_ms']:>8.1f}{stats['strikes']:>9}"
              f"{stats['burnouts']:>10}{stats['leading']:>8.1f}s"
              f"{share:>8.1f}%")

    print()
    print("leader timeline:")
    for node, start, end in metrics['timeline']:
        print(f"  [{start - wall_t0:6.1f}s - {end - wall_t0:6.1f}s] {node}")

    client_view = {}
    for striker in strikers:
        for node, count in striker.served_by.items():
            client_view[node] = client_view.get(node, 0) + count
    if client_view:
        print()
        print("client view (X-Served-By): "
              + ', '.join(f"{node}: {count}"
                          for node, count in sorted(client_view.items())))


######################### The show ############################################

def compose(command, check=True):
    return subprocess.run(['docker', 'compose'] + command, cwd=HOME,
                          check=check)


def wait_for_health(say, nodes, deadline=90.0):
    say("waiting for the nodes to be healthy...")
    limit = time.monotonic() + deadline
    pending = dict(nodes)
    while pending:
        if time.monotonic() > limit:
            raise SystemExit(f"nodes never got healthy: {', '.join(pending)}")
        for name, port in list(pending.items()):
            try:
                status, _, _ = req(port, 'GET', '/health', timeout=2.0)
            except (OSError, http.client.HTTPException):
                continue
            if status == 200:
                pending.pop(name)
        if pending:
            time.sleep(0.5)
    say(f"all {len(nodes)} nodes are healthy")


def wait_for_leader(say, etcd, deadline=30.0):
    limit = time.monotonic() + deadline
    while time.monotonic() < limit:
        try:
            leader = etcd_get(etcd, LEADER_KEY)
        except OSError:
            leader = None
        if leader:
            say(f"we see {leader} is elected leader")
            return leader
        time.sleep(0.25)
    raise SystemExit("nobody claimed the leadership")


def clean_metrics(redis_addr):
    """ A run starts with clean metrics, even over a leftover redis. """

    resp = Resp(*redis_addr)
    try:
        keys = resp.command('KEYS', 'strike:*') or []
        if keys:
            resp.command('DEL', *keys)
    finally:
        resp.close()


def main():
    parser = argparse.ArgumentParser(
        prog='strike-demo',
        description="The calculators' strike: fleet, workload, chaos monkey "
                    "and summary, in about a minute.")
    parser.add_argument('-c', '--clients', type=int, default=5,
                        help="concurrent clients (default: 5)")
    parser.add_argument('-r', '--rate', type=float, default=3.0,
                        help="operations per second per client (default: 3)")
    parser.add_argument('-d', '--duration', type=float, default=60.0,
                        help="run duration in seconds (default: 60)")
    parser.add_argument('--nodes', type=int, default=5,
                        help="number of nodes in the fleet (default: 5)")
    parser.add_argument('--port-base', type=int, default=12345,
                        help="host port of node1, following nodes +1 "
                             "(default: 12345)")
    parser.add_argument('--etcd', default='127.0.0.1:2379',
                        help="etcd address as seen from here "
                             "(default: 127.0.0.1:2379)")
    parser.add_argument('--redis', default='127.0.0.1:6379',
                        help="redis address as seen from here "
                             "(default: 127.0.0.1:6379)")
    parser.add_argument('--gap-min', type=float, default=4.0,
                        help="minimum seconds between chaos strikes (4)")
    parser.add_argument('--gap-max', type=float, default=9.0,
                        help="maximum seconds between chaos strikes (9)")
    parser.add_argument('--skip-up', action='store_true',
                        help="assume the fleet is already running")
    parser.add_argument('--keep', action='store_true',
                        help="leave the fleet running at the end")
    args = parser.parse_args()

    if args.clients < 1:
        parser.error("-c must be >= 1")
    if args.duration <= 0:
        parser.error("-d must be > 0")

    etcd = args.etcd
    redis_addr = tuple(args.redis.split(':')) if ':' in args.redis \
        else (args.redis, 6379)
    nodes = {f"node{index + 1}": args.port_base + index
             for index in range(args.nodes)}

    print("=== The calculators' strike ===")
    t0 = time.monotonic()
    wall_t0 = time.time()

    def say(text):
        print(f"[{time.monotonic() - t0:6.1f}s] {text}", flush=True)

    if not args.skip_up:
        say(f"starting the fleet: etcd + redis + {args.nodes} calculators "
            f"(docker compose up -d --build)")
        try:
            compose(['up', '-d', '--build'])
        except subprocess.CalledProcessError:
            raise SystemExit("docker compose failed, is docker up?")
    else:
        say("skipping the fleet start (--skip-up)")

    clean_metrics(redis_addr)
    wait_for_health(say, nodes)

    offered = f"{args.clients * args.rate:.1f} ops/s"
    say(f"sending load: {args.clients} clients x {args.rate} ops/s "
        f"= {offered} for {args.duration:.0f}s")
    say(f"the chaos monkey is loose: a strike every {args.gap_min:.0f}-"
        f"{args.gap_max:.0f}s")

    stop = threading.Event()
    deadline = t0 + args.duration

    narrator = Narrator(nodes, etcd, stop, t0,
                        leader=wait_for_leader(say, etcd))
    chaos = ChaosMonkey(nodes, stop, t0, args.gap_min, args.gap_max)
    strikers = [Striker(nodes, etcd, args, deadline, stop)
                for _ in range(args.clients)]

    for worker in [narrator, chaos] + strikers:
        worker.start()
    for striker in strikers:
        striker.join()
    stop.set()
    narrator.join(timeout=2.0)

    elapsed = time.monotonic() - t0
    say(f"the run is over: {sum(s.served for s in strikers)} ops served, "
        f"collecting the metrics from redis")

    try:
        metrics = read_metrics(redis_addr, nodes, elapsed, wall_t0)
    except OSError as exc:
        print(f"cannot read the redis metrics: {exc}", file=sys.stderr)
        metrics = {'events': [], 'per_node': {}, 'self_served': 0,
                   'delegated': 0, 'orphans': 0, 'timeline': []}

    print_summary(args, nodes, strikers, chaos, metrics, elapsed, wall_t0)

    if not args.keep:
        say("tearing the fleet down (docker compose down)")
        compose(['down'])
    else:
        say("leaving the fleet running (--keep)")

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\ninterrupted", file=sys.stderr)
        sys.exit(130)
