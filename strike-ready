#!/usr/bin/env python3

# strike-ready: wait until the workforce is ready.
#
# strike-up brings the workforce up; docker compose returns when the
# containers start, not when they answer, and it knows nothing about
# the leadership. This does: every node must answer /health and
# somebody must claim strike/leader. One thing: wait for readiness and
# say so properly when it never comes.
#
#     ./strike-ready

import argparse
import http.client
import sys
import time

import strikeapi


def wait_for_health(node_map, limit):
    """ Every node must answer /health with 200. """

    strikeapi.stamp("waiting for the nodes to be healthy...")
    pending = dict(node_map)
    while pending:
        if time.monotonic() > limit:
            raise SystemExit(f"nodes never got healthy: {', '.join(pending)}")
        for name, port in list(pending.items()):
            try:
                status, _, _ = strikeapi.req(port, 'GET', '/health', timeout=2.0)
            except (OSError, http.client.HTTPException):
                continue
            if status == 200:
                pending.pop(name)
        if pending:
            time.sleep(0.5)
    strikeapi.stamp(f"all {len(node_map)} nodes are healthy")


def wait_for_leader(etcd, limit):
    """ Somebody must claim the strike/leader key. """

    while time.monotonic() < limit:
        try:
            leader = strikeapi.leader_name(etcd)
        except OSError:
            leader = None
        if leader:
            strikeapi.stamp(f"we see {leader} is elected leader")
            return
        time.sleep(0.25)
    raise SystemExit("nobody claimed the leadership")


def main():
    parser = argparse.ArgumentParser(
        prog='strike-ready',
        description="Wait until the workforce answers and has a leader.")
    parser.add_argument('--nodes', type=int, default=5,
                        help="number of nodes in the workforce (default: 5)")
    parser.add_argument('--port-base', type=int, default=12345,
                        help="host port of node1, following nodes +1 "
                             "(default: 12345)")
    parser.add_argument('--etcd', default='127.0.0.1:2379',
                        help="etcd address as seen from here "
                             "(default: 127.0.0.1:2379)")
    parser.add_argument('--deadline', type=float, default=90.0,
                        help="seconds to wait before giving up (default: 90)")
    args = parser.parse_args()

    node_map = strikeapi.nodes(args.nodes, args.port_base)
    limit = time.monotonic() + args.deadline
    wait_for_health(node_map, limit)
    wait_for_leader(args.etcd, limit)
    strikeapi.stamp("the workforce is ready")


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
